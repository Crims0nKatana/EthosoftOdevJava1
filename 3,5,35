import java.util.Scanner;
public class Mavenproject1 {

    public static void main(String[] args) {
        Scanner giris = new Scanner(System.in);
        System.out.println("Lutfen sayi giriniz.");
        int sayi = giris.nextInt();
        if(sayi % 3 == 0 && sayi % 5 == 0){
            System.out.println("Sayi hem 3'e hem 5'e bolunur.");
        }else if (sayi % 3 == 0){
            System.out.println("Sayi sadece 3'e bolunur.");
        }else if (sayi % 5 == 0){
            System.out.println("Sayi sadece 5'e bolunur.");
        }else{
            System.out.println("Sayi ne 3'e ne 5'e bolunur.");
        }
    }
}
